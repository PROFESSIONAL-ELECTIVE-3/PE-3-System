# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local example, replace with Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/eduforecaster

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Base URL of the FastAPI ML microservice
ML_SERVICE_URL=http://localhost:8000